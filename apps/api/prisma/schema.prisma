// court2go — Prisma schema
//
// Owner: prisma-data agent. Source of truth for entities: docs/PRD.md §4.
// Binds to the wire contract in packages/types (field names/enum values kept
// 1:1 with the zod schemas there) WITHOUT ever exposing Prisma types on the
// wire — apps/api maps Prisma entities -> packages/types DTOs in the service
// layer (ARCHITECTURE §3.1). This file intentionally contains implementation
// -only tables (BookingSlot, OtpChallenge, ClientSession, AdminSession,
// AuditLog, PromotionRedemption) that have no equivalent in packages/types.
//
// IMPORTANT — things this file CANNOT express, added via raw SQL in the
// initial migration instead (see prisma/migrations/*/migration.sql and
// docs/ERD.md "Raw SQL additions"):
//   1. The partial unique index that is the entire double-booking guarantee
//      (ADR-0003): `UNIQUE (court_id, slot_start) WHERE released_at IS NULL`
//      on booking_slot. Prisma's `@@unique` has no WHERE clause support.
//   2. Row-Level Security: `ENABLE ROW LEVEL SECURITY` + `CREATE POLICY` on
//      every tenant-owned table (ARCHITECTURE §2.1). No Prisma primitive.
//   3. CHECK constraints (grid interval ∈ {30,60,90,120}, hold window ∈
//      {5,10}, non-negative money, slot_count ∈ [1,maxSlots], etc.) — Prisma's
//      schema DSL has no @check attribute.
//   4. A DB-level trigger mirroring the "Booking reaches CONFIRMED only if
//      Payment ∈ {CONFIRMED, PAY_ONSITE_NOT_COLLECTED}" convergence rule
//      (ARCHITECTURE §6.2/§7, §9 item 5) — defense-in-depth behind the
//      application-level single-writer rule in BookingService.
//   5. A dedicated least-privilege `app_user` Postgres role (non-owner, so it
//      cannot bypass RLS) that apps/api connects as at runtime, distinct from
//      the migration/owner role this schema's `DATABASE_URL` uses.
//
// Two lock granularities are DELIBERATELY kept separate — do not conflate:
//   - `Court.gridIntervalMinutes` / `maxSlots` / pricing = presentation & billing
//     granularity, per PRD A5.1. Admin-configurable, changeable any time.
//   - `BookingSlot.slotStart` = the fixed, platform-wide 30-minute lock lattice
//     (ARCHITECTURE §5.1). NEVER derived from a Court's grid interval.

// Prisma v7: "prisma-client" replaces "prisma-client-js" (Rust engine
// removed) and requires an explicit `output` — no more implicit generation
// into node_modules. moduleFormat is pinned to "cjs" to match this package's
// `"type": "commonjs"` / tsconfig (`module: "CommonJS"`) rather than relying
// on inference. Generated output is gitignored (see /.gitignore) and
// regenerated by `prisma generate` — every model/enum import across
// apps/api/src moved from `@prisma/client` to this path (see prisma.service.ts
// and each `*.repository.ts`).
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

// v7: `url` is no longer accepted here — the CLI's connection URL for
// Migrate/`db seed`/`validate` now comes from `datasource.url` in
// prisma.config.ts (which reads DATABASE_URL, the owner/migration role).
// PrismaClient's runtime connection is unrelated to this block entirely —
// it's supplied by the `@prisma/adapter-pg` driver adapter in
// prisma.service.ts / seed.ts (APP_DATABASE_URL / DATABASE_URL respectively).
datasource db {
  provider = "postgresql"
}

// ============================================================================
// ENUMS — values are 1:1 with packages/types/src/enums/index.ts. Do not rename
// without updating the contract package in the same change.
// ============================================================================

enum BookingStatus {
  PENDING_VERIFICATION
  PENDING_PAYMENT
  PENDING_PAYMENT_CONFIRMATION
  CONFIRMED
  CANCELLATION_REQUESTED
  REJECTED
  EXPIRED
  CANCELLED
  COMPLETED
  NO_SHOW

  @@map("booking_status")
}

enum PaymentStatus {
  AWAITING_SLIP_UPLOAD
  SLIP_UPLOADED_PENDING_REVIEW
  CONFIRMED
  REJECTED
  PAY_ONSITE_NOT_COLLECTED

  @@map("payment_status")
}

enum BranchPaymentMethod {
  PAY_ONSITE
  QR_CODE

  @@map("branch_payment_method")
}

enum Role {
  OWNER
  ADMIN
  BRANCH_ADMIN

  @@map("admin_role")
}

enum Sex {
  MALE
  FEMALE
  OTHER

  @@map("sex")
}

enum OtpPurpose {
  LOGIN
  BIND

  @@map("otp_purpose")
}

enum VerifiedVia {
  SELF_OTP
  ADMIN_OVERRIDE

  @@map("verified_via")
}

enum DiscountType {
  PERCENTAGE
  FIXED

  @@map("discount_type")
}

enum NewsStatus {
  DRAFT
  PUBLISHED

  @@map("news_status")
}

enum DayOfWeek {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN

  @@map("day_of_week")
}

enum ActorType {
  MEMBER
  ADMIN
  SYSTEM

  @@map("actor_type")
}

// ============================================================================
// TENANT ROOT
// ============================================================================

/// Tenant — the venue-operator account (PRD §4). NOT itself tenant-owned (it
/// is the scoping root), so it carries no `tenantId` and no RLS policy is
/// applied to this table — only authenticated internal-ops tooling reads it
/// broadly; every other model's RLS policy chains back to this table's `id`.
model Tenant {
  id   String @id @default(uuid()) @db.Uuid
  slug String @unique @db.VarChar(63)
  name String @db.VarChar(120)

  /// Branding (PRD A8.2) — light white-label, one logo + CI color(s). Kept as
  /// plain columns (1:1 with Tenant, no separate CRUD lifecycle of its own).
  logoUrl        String? @map("logo_url")
  primaryColor   String? @map("primary_color") @db.VarChar(7)
  secondaryColor String? @map("secondary_color") @db.VarChar(7)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  config            Config?
  branches          Branch[]
  sports            Sport[]
  courts            Court[]
  members           Member[]
  clientSessions    ClientSession[]
  otpChallenges     OtpChallenge[]
  adminUsers        AdminUser[]
  adminSessions     AdminSession[]
  bookings          Booking[]
  bookingSlots      BookingSlot[]
  payments          Payment[]
  promotions        Promotion[]
  promoRedemptions  PromotionRedemption[]
  news              News[]
  auditLogs         AuditLog[]
  peakTimeRanges    PeakTimeRange[]
  courtBlocks       CourtBlock[]
  courtScheduleDays CourtScheduleDay[]

  @@map("tenant")
}

/// Tenant-level Config (PRD Domain Glossary, A8.1) — 1:1 with Tenant. All
/// numeric OTP/session/lead-time defaults live here so they're Tenant-
/// overridable without a schema change (ARCHITECTURE §9 item 4).
model Config {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @unique @map("tenant_id") @db.Uuid

  /// MVP-fixed set {5,10} — enforced via CHECK in raw-SQL migration.
  holdWindowMinutes Int @map("hold_window_minutes")

  clientSessionDurationDays Int @map("client_session_duration_days")

  otpExpiryMinutes         Int @map("otp_expiry_minutes")
  otpMaxAttempts           Int @map("otp_max_attempts")
  otpResendCooldownSeconds Int @map("otp_resend_cooldown_seconds")
  otpMaxSendsPerHour       Int @map("otp_max_sends_per_hour")

  minBookingLeadTimeMinutes Int @map("min_booking_lead_time_minutes")
  maxAdvanceBookingDays     Int @map("max_advance_booking_days")

  cancellationCutoffHours Int @default(2) @map("cancellation_cutoff_hours")

  /// Inherited by new Courts unless overridden (PRD A8.1 AC2). Value ∈ {30,60,90,120}.
  defaultGridIntervalMinutes Int @map("default_grid_interval_minutes")
  defaultMaxSlots            Int @map("default_max_slots")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("config")
}

// ============================================================================
// BRANCH / SPORT / COURT
// ============================================================================

/// Branch (PRD §4, A4) — a physical location. `paymentMethod` is the fork
/// point for the whole booking lifecycle (PRD 6a); `promptPayId` is required
/// iff QR_CODE (enforced app-side + CHECK in raw-SQL migration).
model Branch {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  name    String @db.VarChar(120)
  address String @db.VarChar(500)

  paymentMethod BranchPaymentMethod @map("payment_method")
  /// PromptPay-registered phone/national-ID/e-wallet id. NOT a static QR image
  /// (PRD rev 6). Required iff paymentMethod = QR_CODE.
  promptPayId   String?             @map("prompt_pay_id") @db.VarChar(60)

  /// Informational business hours (PRD A4.1 AC1) — display/default only; the
  /// bookable grid is driven by each Court's own schedule (CourtScheduleDay),
  /// not this field, so JSON is sufficient (never queried relationally).
  businessHours Json @map("business_hours")

  isActive  Boolean   @default(true) @map("is_active")
  /// Soft-delete (PRD A4.1 AC4) — blocked while future bookings exist;
  /// enforced in BranchesService, not the DB.
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  courts     Court[]
  adminUsers AdminUser[]
  bookings   Booking[]
  promotions Promotion[]

  @@index([tenantId, isActive])
  @@map("branch")
}

/// Sport (PRD §4, A3) — Tenant-level activity type assigned to Courts.
model Sport {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  name String @db.VarChar(80)

  isActive  Boolean   @default(true) @map("is_active")
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  courts     Court[]
  bookings   Booking[]
  promotions Promotion[]

  @@index([tenantId, isActive])
  @@map("sport")
}

/// Court (PRD §4, A5) — the bookable unit. `gridIntervalMinutes`/`maxSlots`
/// are presentation & billing granularity (NOT the lock lattice — see
/// BookingSlot). `basePricePerGridUnit` is THB satang, PER GRID UNIT of
/// `gridIntervalMinutes` — a different unit from the booking's total price.
model Court {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  branchId String @map("branch_id") @db.Uuid
  sportId  String @map("sport_id") @db.Uuid

  name String @db.VarChar(80)

  /// One of {30,60,90,120} — CHECK constraint added in raw-SQL migration.
  gridIntervalMinutes Int @map("grid_interval_minutes")
  /// Max contiguous grid units per booking, >= 1.
  maxSlots            Int @map("max_slots")

  /// THB satang, per grid unit, off-peak/default rate.
  basePricePerGridUnit Int @map("base_price_per_grid_unit")

  isActive  Boolean   @default(true) @map("is_active")
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)
  sport  Sport  @relation(fields: [sportId], references: [id], onDelete: Restrict)

  schedule       CourtScheduleDay[]
  peakTimeRanges PeakTimeRange[]
  blocks         CourtBlock[]
  bookings       Booking[]
  bookingSlots   BookingSlot[]
  promotions     Promotion[]

  @@index([tenantId, branchId, isActive])
  @@index([tenantId, sportId, isActive])
  @@map("court")
}

/// One day-of-week schedule entry for a Court (PRD A5.1 AC7). Relational (not
/// JSON) because availability computation reads this per court+day on every
/// browse hit — a query path that matters (NFR-driven index below).
model CourtScheduleDay {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  courtId  String @map("court_id") @db.Uuid

  day    DayOfWeek
  closed Boolean

  /// HH:MM wall-clock (nullable iff closed=true) — validated app-side against
  /// the shared `timeOfDaySchema` regex; stored as text to avoid TZ ambiguity.
  openTime  String? @map("open_time") @db.VarChar(5)
  closeTime String? @map("close_time") @db.VarChar(5)

  court  Court  @relation(fields: [courtId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([courtId, day])
  @@index([tenantId, courtId])
  @@map("court_schedule_day")
}

/// A Peak Time Range (PRD A5.1 AC9) — override price for grid units whose
/// START falls within [startTime, endTime) on an applicable day.
model PeakTimeRange {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  courtId  String @map("court_id") @db.Uuid

  label String?     @db.VarChar(60)
  /// Applicable days; native Postgres enum array.
  days  DayOfWeek[]

  startTime String @map("start_time") @db.VarChar(5)
  endTime   String @map("end_time") @db.VarChar(5)

  /// THB satang, per grid unit, overriding the Court base price.
  pricePerGridUnit Int @map("price_per_grid_unit")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  court  Court  @relation(fields: [courtId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, courtId])
  @@map("peak_time_range")
}

/// Maintenance block (PRD A5.1 AC5) — makes a date/time range unavailable on
/// a Court without deactivating it. Consulted at availability-computation and
/// hold-creation time (range overlap check), hence the range index.
model CourtBlock {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  courtId  String @map("court_id") @db.Uuid

  reason String? @db.VarChar(200)

  startsAt DateTime @map("starts_at") @db.Timestamptz(6)
  endsAt   DateTime @map("ends_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  court  Court  @relation(fields: [courtId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, courtId, startsAt, endsAt])
  @@map("court_block")
}

// ============================================================================
// MEMBER / AUTH (client side)
// ============================================================================

/// Member (PRD §4) — a client identified by phone WITHIN a tenant. Unique on
/// (tenantId, phone) — NOT global phone uniqueness (ARCHITECTURE §2.3): the
/// same real phone number gets an independent Member row per Tenant. `phone`
/// is nullable (LINE-login member who hasn't bound a phone yet); Postgres
/// treats NULLs as distinct under a unique index, so many phone-less Members
/// per tenant are fine.
model Member {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  phone         String? @db.VarChar(10)
  /// The single gate that governs booking eligibility (PRD C2.2/C2.3) —
  /// independent of ClientSession state (ARCHITECTURE §3.3).
  phoneVerified Boolean @default(false) @map("phone_verified")

  // Optional profile fields (PRD C6.1) — never required to book.
  name             String? @db.VarChar(120)
  emergencyContact String? @map("emergency_contact") @db.VarChar(120)
  sex              Sex?

  /// LINE Login identity (ARCHITECTURE §4.2) — set once the member has ever
  /// authenticated via LINE. Unique per tenant (nullable-safe, see phone above).
  lineUserId  String?   @map("line_user_id") @db.VarChar(64)
  /// When the member's LINE OA (Official Account) was linked for notifications
  /// (PRD NFR12) — a DISTINCT capability from lineUserId (login identity).
  /// Non-null => `lineBound = true` in the API contract.
  lineBoundAt DateTime? @map("line_bound_at") @db.Timestamptz(6)

  /// Admin-set block (PRD A7.1 AC3). Blocked members cannot complete new
  /// bookings within this tenant; has no effect on other tenants' rows.
  isBlocked     Boolean   @default(false) @map("is_blocked")
  blockedReason String?   @map("blocked_reason") @db.VarChar(500)
  blockedAt     DateTime? @map("blocked_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant           Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientSessions   ClientSession[]
  bookings         Booking[]
  promoRedemptions PromotionRedemption[]

  @@unique([tenantId, phone])
  @@unique([tenantId, lineUserId])
  @@index([tenantId, isBlocked])
  @@map("member")
}

/// Member (client) session (ARCHITECTURE §3.3) — DB-backed, not stateless JWT,
/// so an admin block/logout-everywhere is an immediate `revokedAt` write, not
/// a token-expiry wait. Long-lived; duration from `Config.clientSessionDurationDays`.
model ClientSession {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  memberId String @map("member_id") @db.Uuid

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([tenantId, memberId])
  @@index([tenantId, expiresAt])
  @@map("client_session")
}

/// OTP challenge (ARCHITECTURE §4.1). SMS-only, never LINE. Codes are NEVER
/// stored in plaintext — `codeHash` only. `purpose=BIND` carries `memberId`
/// (the already-logged-in LINE member the phone will bind to, PRD C2.3);
/// `purpose=LOGIN` has `memberId=null` until verification resolves/creates one.
model OtpChallenge {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  phone    String     @db.VarChar(10)
  purpose  OtpPurpose
  /// Set only for BIND (existing LINE-login Member to attach the phone to).
  memberId String?    @map("member_id") @db.Uuid

  codeHash String @map("code_hash")

  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  attempts   Int       @default(0)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// Powers rate-limit checks (resend cooldown + max-sends/hour, PRD C2.5 AC3/AC5).
  @@index([tenantId, phone, createdAt])
  @@map("otp_challenge")
}

// ============================================================================
// ADMIN USER / AUTH (staff side)
// ============================================================================

/// AdminUser (PRD §4, A9). Email+password (ADR-0005). `branchId` non-null
/// ONLY for BRANCH_ADMIN (single-branch scope, enforced server-side in
/// guards — see ARCHITECTURE §3.3 — not by a DB constraint, since Owner/Admin
/// legitimately have `branchId = null`).
model AdminUser {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  email        String @db.VarChar(255)
  passwordHash String @map("password_hash")
  name         String @db.VarChar(120)

  role     Role
  branchId String? @map("branch_id") @db.Uuid

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  sessions         AdminSession[]
  reviewedPayments Payment[]      @relation("PaymentReviewedBy")

  @@unique([tenantId, email])
  @@index([tenantId, branchId])
  @@map("admin_user")
}

/// Admin (staff) session (ARCHITECTURE §3.3) — separate table/cookie from
/// ClientSession so the two principal types can never be confused. Removing
////deactivating an AdminUser cascades to `revokedAt = now()` on all rows
/// (application-level, in AdminUsersService — not a DB trigger).
model AdminSession {
  id          String @id @default(uuid()) @db.Uuid
  tenantId    String @map("tenant_id") @db.Uuid
  adminUserId String @map("admin_user_id") @db.Uuid

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([tenantId, adminUserId])
  @@index([tenantId, expiresAt])
  @@map("admin_session")
}

// ============================================================================
// BOOKING / BOOKING_SLOT / PAYMENT — the safety-critical core (ADR-0003, §6)
// ============================================================================

/// Booking (PRD §4, ARCHITECTURE §6). `branchId`/`sportId` + the *Name/
/// *PaymentMethod snapshot columns are DELIBERATELY denormalized off Court at
/// hold-creation time (not joined live) — PRD A5.1 AC2 and A4.1 AC7 both
/// require that a later Branch/Sport/Court re-assignment or a Branch payment-
/// method change must NEVER retroactively alter a historical booking's
/// displayed context. `gridIntervalMinutes` is likewise snapshotted (ARCHITECTURE
/// §5.4) so a later Court grid-interval change never rewrites past bookings.
model Booking {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  memberId String @map("member_id") @db.Uuid

  courtId  String @map("court_id") @db.Uuid
  /// Snapshot FKs — always equal to court.branchId/sportId at creation time,
  /// but not re-derived later (see model doc comment).
  branchId String @map("branch_id") @db.Uuid
  sportId  String @map("sport_id") @db.Uuid

  /// Denormalized display labels + payment-method fork, snapshotted at hold
  /// time (bookingContextSchema in packages/types) — avoids N extra joins on
  /// every list/calendar render and freezes the branch payment-method the
  /// booking was created under (PRD A4.1 AC7).
  branchName          String              @map("branch_name") @db.VarChar(120)
  sportName           String              @map("sport_name") @db.VarChar(80)
  courtName           String              @map("court_name") @db.VarChar(80)
  branchPaymentMethod BranchPaymentMethod @map("branch_payment_method")

  status BookingStatus

  startsAt            DateTime @map("starts_at") @db.Timestamptz(6)
  endsAt              DateTime @map("ends_at") @db.Timestamptz(6)
  /// Snapshot of Court.gridIntervalMinutes at hold time.
  gridIntervalMinutes Int      @map("grid_interval_minutes")
  slotCount           Int      @map("slot_count")

  /// How the Member identity was verified (PRD A2.2 AC2 audit requirement).
  verifiedVia VerifiedVia @map("verified_via")
  isWalkIn    Boolean     @default(false) @map("is_walk_in")

  /// Full server-computed price breakdown (packages/types `priceBreakdownSchema`)
  /// snapshotted verbatim, incl. the per-grid-unit array — never recomputed
  /// later. `subtotalAmount`/`totalAmount` are the same figures pulled out as
  /// plain columns for cheap aggregation/reporting without parsing JSON.
  priceBreakdown Json @map("price_breakdown")
  subtotalAmount Int  @map("subtotal_amount")
  totalAmount    Int  @map("total_amount")

  appliedPromotionId      String? @map("applied_promotion_id") @db.Uuid
  promotionDiscountAmount Int?    @map("promotion_discount_amount")

  /// When the Hold expires; null once the booking is past PENDING_VERIFICATION/
  /// PENDING_PAYMENT (i.e. terminal or reserved-indefinitely-pending-review).
  holdExpiresAt DateTime? @map("hold_expires_at") @db.Timestamptz(6)

  /// Self-service cancellation request (PRD C4.3) — the request itself; the
  /// admin's approve/decline identity+timestamp live in AuditLog (NFR8).
  cancellationRequestedAt    DateTime? @map("cancellation_requested_at") @db.Timestamptz(6)
  cancellationRequestReason  String?   @map("cancellation_request_reason") @db.VarChar(500)
  cancellationDecisionReason String?   @map("cancellation_decision_reason") @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant           Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  member           Member     @relation(fields: [memberId], references: [id], onDelete: Restrict)
  court            Court      @relation(fields: [courtId], references: [id], onDelete: Restrict)
  branch           Branch     @relation(fields: [branchId], references: [id], onDelete: Restrict)
  sport            Sport      @relation(fields: [sportId], references: [id], onDelete: Restrict)
  appliedPromotion Promotion? @relation(fields: [appliedPromotionId], references: [id], onDelete: SetNull)

  slots           BookingSlot[]
  payment         Payment?
  promoRedemption PromotionRedemption?

  // Query paths that matter: admin calendar (branch+date), admin list
  // (branch/court/status/date filters, PRD A2.1 AC1), member history (C5.1),
  // and the expiry sweep (ARCHITECTURE §5.3, status+holdExpiresAt).
  @@index([tenantId, branchId, startsAt])
  @@index([tenantId, courtId, startsAt])
  @@index([tenantId, status, startsAt])
  @@index([tenantId, memberId, startsAt])
  @@index([tenantId, status, holdExpiresAt])
  @@map("booking")
}

/// BookingSlot (ADR-0003) — one row per FIXED 30-MINUTE LATTICE unit a
/// booking occupies (NOT one row per Court grid unit — see schema-level
/// comment at top of file). `released_at IS NULL` = actively occupying the
/// slot. THE double-booking guarantee is a partial unique index on
/// `(court_id, slot_start) WHERE released_at IS NULL`, added via raw SQL in
/// the initial migration (not expressible here) — see docs/ERD.md.
model BookingSlot {
  id        String @id @default(uuid()) @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid
  courtId   String @map("court_id") @db.Uuid
  bookingId String @map("booking_id") @db.Uuid

  /// Aligned to the fixed platform-wide 30-min lattice, NOT Court.gridIntervalMinutes.
  slotStart  DateTime  @map("slot_start") @db.Timestamptz(6)
  releasedAt DateTime? @map("released_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  court   Court   @relation(fields: [courtId], references: [id], onDelete: Restrict)
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  // Plain (non-unique) index for availability reads + release-by-booking
  // writes. The UNIQUE + partial WHERE clause enforcing the actual guarantee
  // is added via raw SQL (see migration.sql) — DO NOT rely on this index
  // alone for correctness.
  @@index([tenantId, courtId, slotStart, releasedAt])
  @@index([bookingId])
  @@map("booking_slot")
}

/// Payment (PRD §4). 1:1 with Booking. Tracked as a SEPARATE state machine
/// from Booking status, converging only at CONFIRMED (ARCHITECTURE §6.2).
model Payment {
  id        String @id @default(uuid()) @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid
  bookingId String @unique @map("booking_id") @db.Uuid

  status PaymentStatus

  /// THB satang — server-authoritative, equal to Booking.totalAmount.
  amountDue Int @map("amount_due")

  /// Last-generated EMVCo PromptPay payload for this booking (QR_CODE branch
  /// only) — cached for audit/re-display; amount is fixed once the Hold is
  /// created so re-generating is idempotent (ARCHITECTURE §4.3).
  qrPayload String? @map("qr_payload")

  /// Private object-storage key of the uploaded slip (never a public URL —
  /// signed GET URLs are issued on demand, ARCHITECTURE §4.4). Null until
  /// uploaded, and always null for Pay-Onsite bookings.
  slipObjectKey  String?   @map("slip_object_key")
  slipUploadedAt DateTime? @map("slip_uploaded_at") @db.Timestamptz(6)

  /// Audit trail for the manual confirm/reject action (PRD NFR5e).
  reviewedByAdminId String?   @map("reviewed_by_admin_id") @db.Uuid
  reviewedAt        DateTime? @map("reviewed_at") @db.Timestamptz(6)
  rejectionReason   String?   @map("rejection_reason") @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant          Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  booking         Booking    @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  reviewedByAdmin AdminUser? @relation("PaymentReviewedBy", fields: [reviewedByAdminId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@map("payment")
}

// ============================================================================
// PROMOTION
// ============================================================================

/// Promotion (PRD §4, A6, C4.2). Optional scoping to Branch/Sport/Court
/// (null = tenant-wide for that dimension). `totalUses` is a maintained
/// counter (incremented transactionally alongside PromotionRedemption insert)
/// so limit checks don't require a COUNT(*) on the hot booking path.
model Promotion {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  code        String  @db.VarChar(40)
  description String? @db.VarChar(200)

  discountType  DiscountType @map("discount_type")
  /// PERCENTAGE: 1..100. FIXED: THB satang > 0. CHECK added in raw-SQL migration.
  discountValue Int          @map("discount_value")

  validFrom  DateTime @map("valid_from") @db.Timestamptz(6)
  validUntil DateTime @map("valid_until") @db.Timestamptz(6)

  branchId String? @map("branch_id") @db.Uuid
  sportId  String? @map("sport_id") @db.Uuid
  courtId  String? @map("court_id") @db.Uuid

  maxTotalUses     Int? @map("max_total_uses")
  maxUsesPerMember Int? @map("max_uses_per_member")
  totalUses        Int  @default(0) @map("total_uses")

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: Cascade)
  sport  Sport?  @relation(fields: [sportId], references: [id], onDelete: Cascade)
  court  Court?  @relation(fields: [courtId], references: [id], onDelete: Cascade)

  bookings    Booking[]
  redemptions PromotionRedemption[]

  @@unique([tenantId, code])
  @@index([tenantId, isActive, validFrom, validUntil])
  @@map("promotion")
}

/// One redemption of a Promotion by a Member on a Booking (PRD A6.1 AC2/AC4).
/// 1:1 with Booking (a booking applies at most one promotion). Enforces the
/// per-member usage cap via `(promotionId, memberId)` lookups.
model PromotionRedemption {
  id          String @id @default(uuid()) @db.Uuid
  tenantId    String @map("tenant_id") @db.Uuid
  promotionId String @map("promotion_id") @db.Uuid
  bookingId   String @unique @map("booking_id") @db.Uuid
  memberId    String @map("member_id") @db.Uuid

  discountAmount Int      @map("discount_amount")
  usedAt         DateTime @default(now()) @map("used_at") @db.Timestamptz(6)

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  booking   Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  member    Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([tenantId, promotionId, memberId])
  @@map("promotion_redemption")
}

// ============================================================================
// NEWS
// ============================================================================

/// News / Announcement (PRD §4, A10, C0). Tenant-scoped; only PUBLISHED posts
/// appear on the public feed (the default landing page).
model News {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  title String @db.VarChar(200)
  body  String

  imageUrl String? @map("image_url")

  status      NewsStatus
  publishedAt DateTime?  @map("published_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, publishedAt])
  @@map("news")
}

// ============================================================================
// AUDIT LOG
// ============================================================================

/// Generic audit trail (ARCHITECTURE §3.4, NFR8) — every booking status
/// change, payment confirm/reject, and admin CRUD action is one row here,
/// written by the same service methods that perform the transition (not a
/// separate interceptor guessing intent).
model AuditLog {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  actorType ActorType @map("actor_type")
  /// Member.id, AdminUser.id, or null for SYSTEM (e.g. the expiry sweeper).
  actorId   String?   @map("actor_id") @db.Uuid

  action     String @db.VarChar(80)
  entityType String @map("entity_type") @db.VarChar(40)
  entityId   String @map("entity_id") @db.Uuid

  metadata Json?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, entityType, entityId])
  @@index([tenantId, createdAt])
  @@map("audit_log")
}
