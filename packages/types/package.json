{
  "name": "@repo/types",
  "version": "0.1.0",
  "private": true,
  "description": "court2go API contract — single source of truth (zod schemas + inferred TS types + shared enums). Both apps/web and apps/api bind to this; prisma-data models against it.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./enums": {
      "types": "./src/enums/index.ts",
      "import": "./src/enums/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "typescript": "^5.5.4"
  }
}
