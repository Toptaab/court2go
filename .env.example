# court2go env template. copy to .env, fill real values. .env is gitignored.

# --- Database (Postgres) ---
# Owner/migration role — used by `prisma migrate`/`prisma db push` (apps/api/prisma).
# Local dev: `docker compose up -d postgres` (docker-compose.yml at repo root).
DATABASE_URL=postgresql://court2go:court2go@localhost:5433/court2go?schema=public

# Runtime role — LEAST-PRIVILEGE, non-owner Postgres role apps/api's PrismaService
# connects as at request time so Row-Level Security (ARCHITECTURE §2.1) actually
# applies (table owners bypass RLS by default; app_user must NOT be the owner/a
# superuser). Created by the initial migration's raw-SQL section. Same DB, same
# schema, different role/password.
APP_DATABASE_URL=postgresql://app_user:app_user@localhost:5433/court2go?schema=public

# --- LINE Login (user auth) ---
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
LINE_LOGIN_CALLBACK_URL=   # <ngrok-url>/auth/line/callback

# --- LINE Messaging API (OA notifications) ---
LINE_MESSAGING_CHANNEL_ACCESS_TOKEN=
LINE_MESSAGING_CHANNEL_SECRET=
LINE_MESSAGING_WEBHOOK_URL=   # <ngrok-url>/webhooks/line

# --- SMS OTP (STUBBED — OtpSender interface logs code in dev) ---
OTP_SENDER=stub

# --- PromptPay (REAL — deterministic EMVCo, no gateway) ---
# per-Branch PromptPay ID stored in DB, not env

# --- apps/web (Next.js) ---
# Public (ships to the browser bundle): apps/web/lib/api-client.ts calls
# apps/api directly at this origin from both the browser and the Next.js
# server (no proxy layer). Defaults to apps/api's local dev port (API_PORT
# above) when unset.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
